{
  "name": "@your-npm-username/viora",
  "version": "0.1.0",
  "description": "A modern, accessible React component library built with JavaScript, JSX, and CSS Variables.",
  "type": "module",
  "license": "MIT",
  "author": "Asif Islam Bisal",
  "homepage": "https://github.com/AsifIslamBisal/Viora#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AsifIslamBisal/Viora.git"
  },
  "bugs": {
    "url": "https://github.com/AsifIslamBisal/Viora/issues"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "library",
    "css",
    "accessible"
  ],
  "main": "./dist/viora.cjs",
  "module": "./dist/viora.js",
  "style": "./dist/viora.css",
  "exports": {
    ".": {
      "import": "./dist/viora.js",
      "require": "./dist/viora.cjs"
    },
    "./styles.css": "./dist/viora.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vite build",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint .",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
